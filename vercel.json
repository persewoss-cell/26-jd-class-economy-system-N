{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/((?!api|assets).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api?action=system_tick",
      "schedule": "5 15 * * *"
    }
  ],
  "regions": [
    "icn1"
  ]
}
